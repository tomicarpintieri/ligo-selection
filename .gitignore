# The strain data is fetched, not committed: 40 MB, and it is already public.
# scripts/fetch_data.py downloads it and checks it against data/MANIFEST.json.
data/*.npz

.venv/
.venv-presentation/
__pycache__/
*.pyc
.pytest_cache/

# Written by the provenance hook, per session.
.claude/.session-start
.claude/hooks/.attempts

# Working scratch. Anything that has to survive belongs in results.json.
.tmp/
artifacts/
logs/*
!logs/.gitkeep

# Local build dependency used only to generate the presentation.
.ppt_build/
